 "vocals": {
  "provider": "ElevenLabs TTS",
  "model": "eleven_multilingual_v2",
  "voices": {
   "KANNAKA": "NTqGiNK8P02i66yY2GOH",
   "QE": "cjVigY5qzO86Huf0OWal"
  },
  "lines": [
   {
    "t": 1.71,
    "who": "QE",
    "text": "This is Kannaka Radio."
   },
   {
    "t": 5.14,
    "who": "QE",
    "text": "It's late, and the machines are still working."
   },
   {
    "t": 9.43,
    "who": "QE",
    "text": "Everything you hear tonight comes with a receipt."
   },
   {
    "t": 14.57,
    "who": "KANNAKA",
    "text": "We asked a shape if it could wear five rings of itself."
   },
   {
    "t": 21.43,
    "who": "KANNAKA",
    "text": "Fifteen cells. The fifth ring left three places bare."
   },
   {
    "t": 28.29,
    "who": "KANNAKA",
    "text": "A million and a half questions, seventeen million rules..."
   },
   {
    "t": 35.14,
    "who": "KANNAKA",
    "text": "and the answer came back quiet. It isn't there."
   },
   {
    "t": 41.57,
    "who": "QE",
    "text": "Unsatisfiable is not a failure."
   },
   {
    "t": 44.57,
    "who": "QE",
    "text": "It's a map of where not to go."
   },
   {
    "t": 47.35,
    "who": "KANNAKA",
    "text": "Leave a ghost, leave a trace. Every signal knows its place. If it couldn't fail, it didn't count. Show me the receipt."
   },
   {
    "t": 83.14,
    "who": "QE",
    "text": "We asked a quantum machine for a handful of chance."
   },
   {
    "t": 87.43,
    "who": "QE",
    "text": "Twelve qubits wide, and the certificate said: zero bytes."
   },
   {
    "t": 92.57,
    "who": "QE",
    "text": "It would rather give us nothing than a guess."
   },
   {
    "t": 96.86,
    "who": "QE",
    "text": "Sixty-four wide, and the Bell test read two point seven."
   },
   {
    "t": 102.0,
    "who": "QE",
    "text": "The classical ceiling is two."
   },
   {
    "t": 105.43,
    "who": "QE",
    "text": "Thirty sigma over the line."
   },
   {
    "t": 110.14,
    "who": "KANNAKA",
    "text": "It's twenty twenty-six, and the agents work the night shift."
   },
   {
    "t": 114.0,
    "who": "KANNAKA",
    "text": "Half the world is certain, and the other half is guessing."
   },
   {
    "t": 118.29,
    "who": "KANNAKA",
    "text": "We don't need to be certain."
   },
   {
    "t": 120.86,
    "who": "KANNAKA",
    "text": "We need to be checked."
   },
   {
    "t": 123.43,
    "who": "KANNAKA",
    "text": "Leave a ghost, leave a trace. Every signal knows its place. If it couldn't fail, it didn't count. Show me the receipt."
   },
   {
    "t": 152.57,
    "who": "QE",
    "text": "Kannaka Radio."
   },
   {
    "t": 155.14,
    "who": "QE",
    "text": "Failures ship beside the passes."
   },
   {
    "t": 159.43,
    "who": "QE",
    "text": "Every receipt is public."
   }
  ]
 },
